// WARNING: DO NOT EDIT THIS FILE IN VISUAL STUDIO'S RESOURCE EDITOR!
// Editing this file in the Visual Studio resource editor can break the include
// directives and version macros. Edit it manually in a text editor.
#include <windows.h>
#include "SharedVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RC
 PRODUCTVERSION APP_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", DEVELOPER_A
            VALUE "FileDescription", ASI_DESCRIPTION
            VALUE "FileVersion", VERSION_STRING_A
            VALUE "InternalName", ASI_NAME_A
            VALUE "LegalCopyright", "Copyright (C) " CURRENT_YEAR " " DEVELOPER_A
            VALUE "OriginalFilename", GAME_PREFIX_RC ASI_NAME_NO_SPACE_A ".asi"
            VALUE "ProductName", ASI_NAME_A
            VALUE "ProductVersion", VERSION_STRING_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
